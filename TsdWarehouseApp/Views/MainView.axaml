<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TsdWarehouseApp.MainWindow"
        Title="Складской терминал" Width="400" Height="600">
	<StackPanel Margin="16" Spacing="12">

		<!-- Номер ТСД из кэша -->
		<TextBlock Text="Номер ТСД:" FontWeight="Bold"/>
		<TextBox x:Name="TxtTsdNumber" IsReadOnly="True"/>

		<!-- Сканирование бейдж-логина -->
		<TextBlock Text="Сканируйте бейдж (Логин):" FontWeight="Bold"/>
		<TextBox x:Name="TxtLogin" Watermark="Наведите сканер..." KeyUp="OnLoginKeyUp"/>

		<!-- ФИО сотрудника из БД -->
		<TextBlock Text="ФИО сотрудника:" FontWeight="Bold"/>
		<TextBlock x:Name="LblFullName" Text="—" FontSize="16" Foreground="Gray"/>

		<!-- Номер жилетки -->
		<TextBlock Text="Номер жилетки:" FontWeight="Bold"/>
		<TextBox x:Name="TxtVestNumber" Watermark="Введите номер жилетки"/>

		<!-- Кнопка отправки -->
		<Button Content="ОТПРАВИТЬ"
                Click="OnSubmitClicked"
                Background="ForestGreen"
                Foreground="White"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Height="50"
                FontSize="18"/>
	</StackPanel>
</Window>